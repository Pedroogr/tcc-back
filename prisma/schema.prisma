generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  SYSTEM_ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum AuctionHouseStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  LIVE
  FINISHED
  CANCELED
}

enum AuctionMode {
  LIVE
  PRE_BID
  TIMED
  HYBRID
}

enum LotStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  AVAILABLE
  IN_AUCTION
  SOLD
  WITHDRAWN
  REJECTED
}

enum ConsignmentStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum BuyerRegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum BidStatus {
  VALID
  OUTBID
  CANCELED
  WINNING
}

enum StreamStatus {
  WAITING
  LIVE
  ENDED
  ERROR
}

enum CommercialUnit {
  PER_HEAD
  PER_KG
  PER_ARROBA
  PER_POUND
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum SaleStatus {
  PENDING
  CONFIRMED
  CANCELED
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  phone        String?
  document     String?
  platformRole PlatformRole @default(USER)
  status       UserStatus   @default(ACTIVE)

  buyerProfile  BuyerProfile?
  sellerProfile SellerProfile?

  consignments         Consignment[] @relation("SellerConsignments")
  reviewedConsignments Consignment[] @relation("ConsignmentReviewedBy")

  buyerRegistrations         BuyerRegistration[] @relation("BuyerRegistrations")
  reviewedBuyerRegistrations BuyerRegistration[] @relation("BuyerRegistrationReviewedBy")

  bids  Bid[]  @relation("BidderBids")
  sales Sale[] @relation("BuyerSales")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BuyerProfile {
  id     String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  verificationStatus VerificationStatus @default(PENDING)
  creditLimit        Decimal?           @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SellerProfile {
  id     String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ruralRegistration String?
  stateRegistration String?
  farmName          String?
  city              String?
  state             String?
  country           String?

  verificationStatus VerificationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuctionHouse {
  id                 String             @id @default(uuid())
  name               String
  document           String?            @unique
  email              String             @unique
  passwordHash       String
  phone              String?
  city               String?
  state              String?
  country            String?
  logoUrl            String?
  status             AuctionHouseStatus @default(ACTIVE)
  mustChangePassword Boolean            @default(false)

  auctions     Auction[]
  consignments Consignment[]
  saleRecords  Sale[]        @relation("SaleRecordedByAuctionHouse")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Auction {
  id          String        @id @default(uuid())
  title       String
  description String?
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  status      AuctionStatus @default(DRAFT)
  mode        AuctionMode   @default(LIVE)

  auctionHouseId String
  auctionHouse   AuctionHouse @relation(fields: [auctionHouseId], references: [id], onDelete: Cascade)

  settings AuctionSettings?
  stream   Stream?
  lots     Lot[]

  buyerRegistrations BuyerRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auctionHouseId])
  @@index([status])
}

model AuctionSettings {
  id String @id @default(uuid())

  auctionId String  @unique
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  country        String         @default("BR")
  currency       String         @default("BRL")
  language       String         @default("pt-BR")
  commercialUnit CommercialUnit @default(PER_HEAD)

  minBidIncrement Decimal @default(0) @db.Decimal(12, 2)

  requiresBuyerApproval Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Consignment {
  id          String            @id @default(uuid())
  status      ConsignmentStatus @default(SUBMITTED)
  sellerNotes String?
  reviewNotes String?
  reviewedAt  DateTime?

  sellerId String
  seller   User   @relation("SellerConsignments", fields: [sellerId], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("ConsignmentReviewedBy", fields: [reviewedById], references: [id])

  auctionHouseId String
  auctionHouse   AuctionHouse @relation(fields: [auctionHouseId], references: [id], onDelete: Cascade)

  lot Lot?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([auctionHouseId])
  @@index([status])
}

model Lot {
  id          String  @id @default(uuid())
  code        String
  title       String
  description String?

  breed     String?
  category  String?
  sex       String?
  ageMonths Int?
  weightKg  Float?
  quantity  Int     @default(1)

  initialPrice Decimal? @db.Decimal(12, 2)

  status LotStatus @default(DRAFT)

  auctionId String?
  auction   Auction? @relation(fields: [auctionId], references: [id], onDelete: SetNull)

  consignmentId String?      @unique
  consignment   Consignment? @relation(fields: [consignmentId], references: [id], onDelete: SetNull)

  media LotMedia[]
  bids  Bid[]
  sale  Sale?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auctionId])
  @@index([auctionId, code])
  @@index([status])
}

model LotMedia {
  id          String    @id @default(uuid())
  type        MediaType
  url         String
  description String?
  sortOrder   Int       @default(0)

  lotId String
  lot   Lot    @relation(fields: [lotId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lotId])
}

model BuyerRegistration {
  id     String                  @id @default(uuid())
  status BuyerRegistrationStatus @default(PENDING)
  notes  String?

  buyerId String
  buyer   User   @relation("BuyerRegistrations", fields: [buyerId], references: [id], onDelete: Cascade)

  auctionId String
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  reviewedById String?
  reviewedBy   User?   @relation("BuyerRegistrationReviewedBy", fields: [reviewedById], references: [id])

  approvedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerId, auctionId])
  @@index([buyerId])
  @@index([auctionId])
  @@index([status])
}

model Bid {
  id     String    @id @default(uuid())
  amount Decimal   @db.Decimal(12, 2)
  status BidStatus @default(VALID)

  bidderId String
  bidder   User   @relation("BidderBids", fields: [bidderId], references: [id], onDelete: Cascade)

  lotId String
  lot   Lot    @relation(fields: [lotId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bidderId])
  @@index([lotId])
  @@index([lotId, createdAt])
}

model Stream {
  id        String       @id @default(uuid())
  status    StreamStatus @default(WAITING)

  streamUrl String?
  protocol  String?
  startedAt DateTime?
  endedAt   DateTime?

  auctionId String  @unique
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sale {
  id         String     @id @default(uuid())
  finalPrice Decimal    @db.Decimal(12, 2)
  status     SaleStatus @default(CONFIRMED)
  soldAt     DateTime   @default(now())
  notes      String?

  lotId String @unique
  lot   Lot    @relation(fields: [lotId], references: [id], onDelete: Cascade)

  buyerId String
  buyer   User   @relation("BuyerSales", fields: [buyerId], references: [id])

  saleRecordedByAuctionHouseId String
  saleRecordedByAuctionHouse   AuctionHouse @relation("SaleRecordedByAuctionHouse", fields: [saleRecordedByAuctionHouseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([saleRecordedByAuctionHouseId])
}
