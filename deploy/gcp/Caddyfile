{
	admin off
	auto_https off
}

:8080 {
	@api path /api /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy api:3000
	}

	@socket path /socket.io/*
	handle @socket {
		reverse_proxy api:3000
	}

	@pose path /v1/pose
	handle @pose {
		reverse_proxy worker:8765
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
